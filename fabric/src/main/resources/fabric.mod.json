{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "CoreVK",
	"description": "OptiFine-format shader packs, on Minecraft's native Vulkan renderer",
	"authors": [
		"AtommHere"
	],
	"contact": {
		"homepage": "https://github.com/avpbynf/CoreVK-Shaders",
		"sources": "https://github.com/avpbynf/CoreVK-Shaders",
		"issues": "https://github.com/avpbynf/CoreVK-Shaders/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "corevk.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.corevk.corevk.fabric.CoreVKFabric"
		],
		"sodium:config_api_user": [
			"net.corevk.corevk.sodium.ConfigEntry"
		]
	},
	"mixins": [
		"corevk.mixins.json",
		"corevk-game.mixins.json",
		"corevk-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min_version}",
		"minecraft": ">=${minecraft_version} <${minecraft_next}",
		"sodium": "0.9.x",
		"fabric-key-mapping-api-v1": "*",
		"fabric-lifecycle-events-v1": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.features.render.world.sky": false
		}
	}
}
